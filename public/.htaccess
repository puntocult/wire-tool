# wire.tool auf Apache-Webspace (wird bei nginx o. Ä. einfach ignoriert)

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Dateien mit Hash im Namen ändern sich nie → lange cachen
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Service Worker, Startseite und Manifest immer frisch prüfen, damit Updates ankommen
  <FilesMatch "^(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
